#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# dependencies = ["beets"]
# ///
"""Sync beets library to Music.app for tracks matching a beets query.

Adds tracks whose files are not yet in Music.app, then writes whichever
metadata differs from beets. Each beets item remembers its Music.app track in
the `music_pid` and `music_path` flexible fields; a stored ID is used only
while that track still exists and the item is still at `music_path`, and
tracks without one are resolved by file location. Synced metadata includes the `favorited` flexible field
(additive: sync never un-favorites in Music.app, so favorites made there
since the last pull survive).

With --pull-favorites, runs in reverse instead: reads favorited (starred)
tracks from Music.app and sets `favorited=1` on the beets items at the same
paths. Query favorites with `beet ls favorited:1`.

Usage:
    beet-music-sync [--verify] [beets query...]
    beet-music-sync --pull-favorites [--dry-run]

Examples:
    beet-music-sync                    # sync everything
    beet-music-sync albumartist:C418
    beet-music-sync album:TUNIC
    beet-music-sync --verify           # re-resolve every track by location
    beet-music-sync --pull-favorites   # Music.app favorites -> beets
"""

import itertools
import os
import subprocess
import sys
import unicodedata

from beets import config
from beets.library import Item, Library, parse_query_parts


def esc(s):
    return str(s or "").replace("\\", "\\\\").replace('"', '\\"')


def _run_applescript(script, label, phase):
    result = subprocess.run(
        ["osascript", "-e", script], capture_output=True, text=True, check=False
    )
    if result.returncode != 0:
        print(f"  ERROR ({phase}) '{label}': {result.stderr.strip()}", file=sys.stderr)
        return None
    return result.stdout.strip()


# Each `{...} of every file track` property fetch is one Apple event for the
# whole library. The columns are joined with ASCII unit/record separators in a
# single coercion: building the output string track by track is quadratic.
# Fetching `location` costs ~5-15 s on a ~9k-track library, against well under
# a second for the other properties, so it has a script of its own.
COLUMNS_SCRIPT = """
tell application "Music"
    set cols to {%s} of every file track of library playlist 1
end tell
set AppleScript's text item delimiters to character id 31
set out to {path to startup disk as text}
repeat with col in cols
    set end of out to (contents of col) as text
end repeat
set AppleScript's text item delimiters to character id 30
return out as text
"""

FIELDS = (
    "persistent ID",
    "name",
    "artist",
    "album artist",
    "album",
    "year",
    "composer",
    "disc number",
    "favorited",
)

# Above this many tracks without a usable stored persistent ID, one location
# fetch is cheaper than resolving each track with its own `add` call.
LOCATION_FETCH_THRESHOLD = 50


def path_key(path):
    # Music.app and beets disagree on Unicode normalization, and APFS is
    # case-insensitive, so a renamed directory can differ only in case.
    return unicodedata.normalize("NFC", path).casefold()


def hfs_to_posix(hfs, startup_disk):
    # HFS paths separate components with ':' and allow '/' in names; POSIX
    # paths are the other way round.
    if hfs.startswith(startup_disk):
        rest, prefix = hfs[len(startup_disk) :], "/"
    else:
        volume, _, rest = hfs.partition(":")
        prefix = f"/Volumes/{volume}/"
    return prefix + rest.translate(str.maketrans(":/", "/:"))


def fetch_columns(props):
    """Fetch props of every Music.app file track, returning the startup disk's
    HFS name and one list of values per property."""
    script = COLUMNS_SCRIPT % ", ".join(props)
    out = _run_applescript(script, "Music.app", "fetch library")
    if out is None:
        sys.exit(1)
    startup_disk, *cols = out.split("\x1e")
    return startup_disk, [col.split("\x1f") for col in cols]


def fetch_library():
    """Fetch the synced properties of every Music.app file track, keyed by
    persistent ID."""
    _, cols = fetch_columns(FIELDS)
    return {
        values[0]: dict(zip(FIELDS, values, strict=True))
        for values in zip(*cols, strict=True)
    }


def fetch_locations():
    """Fetch the persistent ID of every Music.app file track, keyed by
    [path_key] of its location."""
    startup_disk, (pids, locations) = fetch_columns(("persistent ID", "location"))
    return {
        path_key(hfs_to_posix(location, startup_disk)): pid
        for pid, location in zip(pids, locations, strict=True)
        if location != "missing value"
    }


def item_path(item):
    return os.fsdecode(item.path) if isinstance(item.path, bytes) else item.path


def stored_pid(item, library):
    """Return item's stored Music.app persistent ID, or None when the track
    is gone from library or beets has since put the item at another path."""
    pid = item.get("music_pid")
    if pid in library and item.get("music_path") == item_path(item):
        return pid
    return None


def store_pids(lib, pids):
    """Record each item's Music.app persistent ID and the path it was
    resolved for, so later runs can skip the location fetch."""
    with lib.transaction():
        for item, pid in pids:
            if stored_pid(item, {pid}) != pid:
                item["music_pid"] = pid
                item["music_path"] = item_path(item)
                item.store()


def resolve_pids(lib, tracks, library, verify):
    """Resolve each of tracks to its Music.app persistent ID, adding files
    that aren't in Music.app yet.

    Returns {item id: persistent ID} and {album label: tracks added}.
    """
    pids = {}
    unresolved = []
    for item in tracks:
        if not verify and (pid := stored_pid(item, library)):
            pids[item.id] = pid
        else:
            unresolved.append(item)

    if verify or len(unresolved) > LOCATION_FETCH_THRESHOLD:
        locations = fetch_locations()
        remaining = []
        for item in unresolved:
            if pid := locations.get(path_key(item_path(item))):
                pids[item.id] = pid
            else:
                remaining.append(item)
        unresolved = remaining

    # `add` of a file already in the library returns its existing track, so it
    # resolves and adds in one step. Batching multiple add calls in one
    # AppleScript triggers a Music.app internal queuing race (-1700 "Can't make
    # some data into the expected type"), so each file gets its own call.
    added = {}
    for item in unresolved:
        label = album_label(item)
        script = "\n".join(
            [
                'tell application "Music"',
                f'    set newTrack to add (POSIX file "{esc(item_path(item))}")',
                "    return persistent ID of newTrack",
                "end tell",
            ]
        )
        if pid := _run_applescript(script, label, f"add '{item.title}'"):
            pids[item.id] = pid
            if pid not in library:
                added[label] = added.get(label, 0) + 1

    store_pids(lib, [(item, pids[item.id]) for item in tracks if item.id in pids])
    return pids, added


def album_label(item):
    return f"{item.albumartist} - {item.album}" if item.albumartist else item.album


def pull_favorites(lib, dry_run):
    favorites = {
        pid: track
        for pid, track in fetch_library().items()
        if track["favorited"] == "true"
    }
    print(f"Found {len(favorites)} favorited track(s) in Music.app.")

    items = list(lib.items())
    by_pid = {pid: item for item in items if (pid := stored_pid(item, favorites))}
    if len(by_pid) < len(favorites):
        locations = fetch_locations()
        for item in items:
            pid = locations.get(path_key(item_path(item)))
            if pid in favorites:
                by_pid.setdefault(pid, item)

    matched = already = 0
    for pid, item in by_pid.items():
        del favorites[pid]
        if item.get("favorited"):
            already += 1
            continue
        matched += 1
        print(f"  + {item.artist} - {item.album} - {item.title}")
        if not dry_run:
            item["favorited"] = 1
            item.store()

    verb = "would set" if dry_run else "set"
    print(f"\n{verb} favorited=1 on {matched} item(s); {already} already set.")
    if favorites:
        print(f"\n{len(favorites)} not found in beets:")
        for track in favorites.values():
            print(f"  ? {track['artist']} - {track['album']} - {track['name']}")


def wanted_properties(item):
    """Return the Music.app properties beets sets for item, as AppleScript
    literals keyed by property name."""
    props = {
        # Music.app keeps only the first 255 code points of a track name.
        "name": f'"{esc(item.title[:255])}"',
        "artist": f'"{esc(item.artist)}"',
        "album artist": f'"{esc(item.albumartist)}"',
        "album": f'"{esc(item.album)}"',
    }
    if item.year:
        props["year"] = str(int(item.year))
    if composer := item.get("composer"):
        props["composer"] = f'"{esc(composer)}"'
    if discnum := int(item.disc or 0):
        props["disc number"] = str(discnum)
    # Additive on purpose: favorites made in Music.app since the last
    # --pull-favorites run must survive a sync.
    if item.get("favorited"):
        props["favorited"] = "true"
    return props


def as_literal(prop, value):
    if prop in ("year", "disc number", "favorited"):
        return value
    nfc = unicodedata.normalize("NFC", value)
    return f'"{esc(nfc)}"'


def changed_properties(item, current):
    """Return the properties of item that differ from current, the track's
    Music.app properties (None for a track added this run)."""
    wanted = wanted_properties(item)
    if current is None:
        return wanted
    return {
        prop: value
        for prop, value in wanted.items()
        if unicodedata.normalize("NFC", value) != as_literal(prop, current[prop])
    }


def sync_to_music(lib, tracks, verify):
    tracks = [item for item in tracks if item.album]
    library = fetch_library()
    pids, added = resolve_pids(lib, tracks, library, verify)

    labels = sorted({album_label(item) for item in tracks})
    added = {label: added.get(label, 0) for label in labels}
    updates = []  # (label, persistent ID, {property: literal})
    for item in tracks:
        if item.id not in pids:
            continue
        pid = pids[item.id]
        if props := changed_properties(item, library.get(pid)):
            updates.append((album_label(item), pid, props))

    updated = dict.fromkeys(added, 0)
    # Batches of 50 tracks stay under AppleScript's script size limits.
    for batch in itertools.batched(updates, 50):
        lines = ['tell application "Music"', "    set lib to library playlist 1"]
        for _, pid, props in batch:
            lines.append(
                f'    repeat with aTrack in (every file track of lib whose persistent ID is "{pid}")'
            )
            lines.extend(
                f"        set {prop} of aTrack to {value}"
                for prop, value in props.items()
            )
            lines.append("    end repeat")
        lines.append("end tell")
        labels = sorted({label for label, _, _ in batch})
        if _run_applescript("\n".join(lines), ", ".join(labels), "sync") is not None:
            for label, _, _ in batch:
                updated[label] += 1

    for label, count in added.items():
        parts = []
        if count:
            parts.append(f"{count} added")
        if synced := updated[label] - count:
            parts.append(f"{synced} updated")
        if parts:
            print(f"  {label}: {', '.join(parts)}")

    total_added = sum(added.values())
    total_synced = sum(updated.values()) - total_added
    summary = []
    if total_added:
        summary.append(f"{total_added} added")
    if total_synced:
        summary.append(f"{total_synced} updated")
    print(f"\n{', '.join(summary) or 'nothing to do'}.")


if __name__ == "__main__":
    args = sys.argv[1:]
    pull = "--pull-favorites" in args
    dry_run = "--dry-run" in args
    verify = "--verify" in args
    flags = ("--pull-favorites", "--dry-run", "--verify")
    args = [a for a in args if a not in flags]
    if pull and args:
        sys.exit("--pull-favorites does not take a query")
    if dry_run and not pull:
        sys.exit("--dry-run only applies to --pull-favorites")
    if verify and pull:
        sys.exit("--verify does not apply to --pull-favorites")

    config.read()
    lib = Library(
        config["library"].as_filename(),
        directory=config["directory"].as_filename(),
    )

    if pull:
        pull_favorites(lib, dry_run)
    else:
        query, sort = parse_query_parts(args, Item)
        tracks = list(lib.items(query, sort))
        print(f"Found {len(tracks)} track(s). Syncing to Music.app...")
        sync_to_music(lib, tracks, verify)
