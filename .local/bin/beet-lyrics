#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# dependencies = []
# ///
"""Fetch lyrics with beets, one worker per album artist, skipping instrumentals.

Tracks flagged instrumental through either the hand-maintained `instrumental`
field or the `lyrics_instrumental` field that beets sets are excluded. The
lyrics plugin skips a track only when its `lyrics` field is non-empty, and
`lyrics.auto_ignore` applies only on import, so without the exclusion every
run queries LRClib again for every instrumental track.

Usage:
    beet-lyrics [-f] [-a] [beets query...]

Examples:
    beet-lyrics                     # fetch for everything (skips tracks with lyrics)
    beet-lyrics -f                  # refetch even if lyrics already exist
    beet-lyrics albumartist:Burial  # fetch for a specific artist
"""

import argparse
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed

WORKERS = 32

ARTIST_TIMEOUT = (
    120  # seconds; prevents a single stalled API call from blocking a worker
)

EXCLUDE_INSTRUMENTALS = ["^instrumental:true", "^lyrics_instrumental:true"]


def beet(*args: str) -> str:
    return subprocess.run(
        ["beet", *args], capture_output=True, text=True, check=True
    ).stdout


def get_artists(force: bool, query: list[str]) -> list[str]:
    # When not forcing, skip artists where every track already has lyrics
    lyrics_filter = [] if force else ["^lyrics::."]
    output = beet("list", "-f", "$albumartist", *lyrics_filter, *query)
    return sorted({line.strip() for line in output.splitlines() if line.strip()})


def fetch_for_artist(
    artist: str, force: bool, query: list[str]
) -> tuple[str, str, str]:
    cmd = ["beet", "lyrics"]
    if force:
        cmd.append("-f")
    cmd.extend([*query, f"albumartist:{artist}"])
    try:
        result = subprocess.run(
            cmd, capture_output=True, text=True, timeout=ARTIST_TIMEOUT, check=False
        )
    except subprocess.TimeoutExpired:
        return artist, "", f"timed out after {ARTIST_TIMEOUT}s"
    return artist, result.stdout.strip(), result.stderr.strip()


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "-f",
        "--force",
        action="store_true",
        help="refetch lyrics even if already present",
    )
    parser.add_argument(
        "-a",
        "--all",
        action="store_true",
        help="don't exclude tracks flagged instrumental",
    )
    args, query_args = parser.parse_known_args()
    query = query_args if args.all else [*EXCLUDE_INSTRUMENTALS, *query_args]

    artists = get_artists(args.force, query)
    total = len(artists)
    print(f"Fetching lyrics for {total} artists ({WORKERS} in parallel)...")

    done = 0
    with ThreadPoolExecutor(max_workers=WORKERS) as pool:
        futures = {
            pool.submit(fetch_for_artist, artist, args.force, query): artist
            for artist in artists
        }
        for future in as_completed(futures):
            artist, stdout, stderr = future.result()
            done += 1
            print(f"[{done}/{total}] {artist}", flush=True)
            for line in stdout.splitlines():
                print(f"  {line}")
            if stderr:
                print(f"  ERROR: {stderr}", file=sys.stderr)
