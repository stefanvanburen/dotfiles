<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.stefanvanburen.ssh-add</string>
	<!-- launchd's ssh-agent job starts empty at every login, so anything that
	     speaks only to the agent socket (OrbStack Linux machines, forwarded
	     agents, `docker build --ssh`) fails until a key is loaded. Load the
	     default ~/.ssh identities at login, taking passphrases from the
	     keychain where they exist.

	     --apple-load-keychain only loads keys whose passphrase is ALREADY in
	     the login keychain; plain `ssh-add` never puts one there, only
	     `ssh-add --apple-use-keychain <key>` does. Without that entry this
	     job exits 1 at every login, which is why it is worth logging.

	     launchd takes StandardOutPath literally, with no $HOME or ~
	     expansion, so the shell redirects the log to keep this file
	     portable across machines with different usernames. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>exec /usr/bin/ssh-add --apple-load-keychain &gt;&gt;"$HOME/Library/Logs/ssh-add-login.log" 2&gt;&amp;1</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
