;; ignore the "Non-deterministic" version warnings - we just want to use the
;; latest in these "tools".
#_:clj-kondo/ignore
{:aliases
 {;; `clojure -M:repl` starts an nREPL server (writing `.nrepl-port` for
  ;; Conjure) and spawns a terminal client in its own JVM.
  ;; Configured in .cljconf/org.clojure/clojure-cli.repl.edn.
  ;; See https://github.com/clojure/clojure-cli.repl
  :repl {:extra-deps {io.github.clojure/clojure-cli.repl-server {:mvn/version "RELEASE"}}
         :main-opts ["-m" "clojure-cli.repl.server" "repl"]}}}
